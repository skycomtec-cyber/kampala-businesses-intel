# Kampala Businesses Intel - environment
#
# Copy to `.env` in this folder and edit. `loadConfig` reads `.env` on start, and
# anything already in the environment wins, so a systemd `EnvironmentFile`, a
# Compose `env_file`, or `docker run -e` all override this file without editing it.
#
#   cp .env.example .env
#
# Every value below is optional. The defaults are the ones in `src/config.js`, so a
# fresh checkout boots with nothing configured and stays on 127.0.0.1. Set a value
# only when you are deploying to someone else's machine.
#
# A note on what this file is not: it is not a place to put a real secret and commit
# it. `.env` is gitignored. Anything secret belongs in your secret manager and
# reaches the process through the environment.


# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# The address the server binds to. 127.0.0.1 keeps it off the internet, which is
# the default and the right answer whenever a reverse proxy, a container network,
# or a tunnel is in front of it.
#
# Set to 0.0.0.0 ONLY if you have a firewall in front and understand that every
# address on the machine can now reach the operator login.
KIP_HOST=127.0.0.1

# The port to listen on. Pin this explicitly when you run more than one install on
# a host, and when a reverse proxy needs a fixed upstream to point at.
KIP_PORT=4310

# Only set this to true when a proxy you control is the thing setting
# X-Forwarded-For. Left false, a client can spoof its own address and walk straight
# past the per-IP rate limiter on sign-in. Turning it on without a real proxy in
# front is the same as having no rate limit.
KIP_TRUST_PROXY=false


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# The directory holding the database, the session secret, the live-process lock,
# and the backups directory.
#
# This is the one path worth setting on a server. Put it on the volume you actually
# back up and mount into containers, because it is the only directory where state
# lives. Everything else in the app folder is replaceable from git.
#
# A path with a space or a `#` in it is fine here; the .env reader strips quotes
# and does not interpret escapes.
KIP_DATA_DIR=./data

# Overrides the database file inside KIP_DATA_DIR. Leave this unset unless you
# deliberately keep the database somewhere else, such as a mounted volume in a
# container. A relative value is resolved against the working directory, not the
# data directory, so prefer an absolute path if you set it at all.
# KIP_DB_FILE=/var/lib/kampala/kampala.db

# Where uploaded business photographs are stored. Defaults to `media` inside
# KIP_DATA_DIR, which keeps the database and the files it references together:
# back one up without the other and the restored rows point at nothing. Point it
# somewhere else only if the images belong on separate storage, and move the
# existing folder with it.
# KIP_MEDIA_DIR=/var/lib/kampala/media

# The storage driver. `sqlite` is the only implemented adapter today; the repository
# layer is what would change, not this file. It is here so a future Postgres deploy
# is a value rather than a fork.
KIP_DB_DRIVER=sqlite


# ---------------------------------------------------------------------------
# Sessions and sign-in
# ---------------------------------------------------------------------------

# Signs session cookies. If you leave this unset the app generates a random one and
# writes it to KIP_DATA_DIR/.session-secret, which works fine for a single install
# and survives restarts.
#
# Set it explicitly when: there is more than one process sharing one data directory,
# or the data directory is on storage that does not keep dotfiles (some container
# volume drivers do not). It must be at least 32 characters, and anything shorter is
# ignored in favour of the generated file.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# KIP_SESSION_SECRET=

# How long a signed session stays valid. 12 hours covers a working day.
KIP_SESSION_TTL_HOURS=12

# The session cookie's name. Change it only if two installs on the same host share
# a domain, where the browser would otherwise send one install's cookie to both.
KIP_COOKIE_NAME=kip_session

# Minimum password length enforced when creating an operator account. 12 characters
# is the floor, and this value cannot lower it below what the core layer accepts.
KIP_MIN_PASSWORD_LENGTH=12


# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
#
# These are the settings that decide what the platform is allowed to show, so they
# are documented more carefully than their size suggests.

# The k-anonymity floor. Any aggregate computed over fewer than this many distinct
# actors is suppressed before it can leave the engine. 5 is the default and the
# value the thresholds in the README assume.
#
# Raising it protects more and reveals less. Lowering it to 1 disables the
# protection entirely, and will make small-area counts identifiable.
KIP_K_THRESHOLD=5

# Days before the pseudonymisation salt rotates. 1 keeps the search trends useful
# across a month while stopping an individual searcher's history from staying
# linkable.
KIP_ROTATION_DAYS=1

# How long the verbatim search text is kept, in days. This is the ONLY table here
# that can name a person, so it is the shorter of the two windows.
KIP_RAW_SEARCH_RETENTION_DAYS=30

# How long the pseudonymous aggregate is kept, in days. Longer than the raw window,
# because it cannot identify anyone and it is what the trend work actually uses.
#
# If you set the raw window above this one, it is clamped down to match rather than
# refused: the schema cascades on delete, so the text would go first regardless and
# keeping the longer value would only make the reported lifetime a lie. /api/v1/meta
# publishes both numbers, so you can check which one is actually in force.
KIP_EVENT_RETENTION_DAYS=90


# ---------------------------------------------------------------------------
# Intelligence engine
# ---------------------------------------------------------------------------

# The window a demand gap is measured over. 30 days is the shortest span in which a
# business's own decision cycle fits.
KIP_GAP_WINDOW_DAYS=30

# Ceiling on phrases measured per run. Each costs one FTS query against the supply
# index; the ordering is by demand, so the cap drops the weakest signals rather than
# a random sample of the strong ones.
KIP_GAP_MAX_SIGNALS=200

# Minimum severity promoted to an actionable opportunity: low, moderate, high, or
# critical. Findings below the floor are still stored and shown in the lab; they are
# just not promoted to the opportunity list.
KIP_GAP_OPPORTUNITY_FLOOR=moderate

# Comparison window, in days, for the rising/falling annotation.
KIP_GAP_TREND_WINDOW_DAYS=7


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# pino log level: trace, debug, info, warn, error, fatal, or silent. Set to warn in
# production if you are not going to read them - the structured logs include query
# timings and will otherwise be noisy.
#
# Read directly by src/api/index.js rather than through loadConfig, because the
# logger is built before the config object exists.
KIP_LOG_LEVEL=info


# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------

# Route prefix. Set to /api/v2 to mount a new version beside this one instead of
# breaking every existing client at once.
KIP_API_PREFIX=/api/v1

# Maximum request body, in bytes, rejected before parsing. A business profile with a
# few hundred characters of text is the largest legitimate request.
KIP_BODY_LIMIT=262144

# The larger ceiling for a photo upload, in bytes, applied to that route alone. A
# photo arrives as a base64 data url, which inflates the image by about a third, so
# this is bigger than the image ceiling it guards (4 MB of image bytes). Every other
# request is still refused at KIP_BODY_LIMIT.
KIP_PHOTO_BODY_LIMIT=6291456


# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------

# Administrative locations and the taxonomy. Real-world reference data, not
# synthetic content, so this belongs in every install.
KIP_SEED_REFERENCE=true

# The one real organisation imported through the catalogue on every start. It arrives
# `pending_review` and is never published by the seed, so switching it off only
# removes a queue item. Turn it off once the install has its own business listed.
KIP_SEED_CATALOGUE_DEMO=true


# ---------------------------------------------------------------------------
# Administration
# ---------------------------------------------------------------------------
#
# Read by `npm run bootstrap` and `npm run create-admin`. These are one-shot
# commands, not the server, so they are not here by default - leaving an admin
# password in a file the server loads on every start is a way to leak one.
# KIP_ADMIN_EMAIL=operator@example.com
# KIP_ADMIN_PASSWORD=
# KIP_ADMIN_NAME=