# Kampala Businesses Intel - hardened production environment
#
# This is the deployment counterpart to `.env.example`. That file is the full
# annotated reference and is written for a fresh checkout; this one is written for
# a host that is reachable by other people, and it only names the values that
# should change once the install stops being local. Anything not listed here keeps
# its `.env.example` default.
#
# How to use it:
#
#   cp .env.production.example .env        # or point systemd/compose at this file
#
# The systemd unit already expects a root-owned 0600 EnvironmentFile, which is the
# better home for this on a server than the checked-out `.env`:
#
#   sudo install -m 600 -o root -g kampala .env.production.example /etc/kampala-intel.env
#   sudo editor /etc/kampala-intel.env
#
# Nothing secret belongs in this file in the repository. The session secret is
# the one value that is genuinely a secret; it is read from the environment (or a
# secret manager that populates it) and is left unset below on purpose.


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Read by `src/api/index.js` and by the auth routes. Anything other than
# `production` is treated as development, and the development branch of
# /auth/password-reset returns the reset token in the response body because no
# mail transport is wired up. Leaving this unset on a public host therefore hands
# a working reset token to anyone who asks for one. Set it.
NODE_ENV=production


# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Loopback only. A reverse proxy (the shipped `deploy/nginx-kampala-intel.conf`)
# is the thing that terminates TLS and faces the internet. The app itself never
# speaks TLS, so binding 0.0.0.0 would put the operator sign-in on the wire in
# clear text.
KIP_HOST=127.0.0.1
KIP_PORT=4310

# Honoured ONLY because a proxy you control sets X-Forwarded-For and
# X-Forwarded-Proto. Turning this on with nothing in front lets any client forge
# its own address past the per-IP sign-in limiter, and is strictly worse than
# leaving it off. It is also what makes the session cookie `Secure`: the cookie's
# flag follows `request.protocol`, which is only `https` when this is true and the
# proxy sent the header. Behind the shipped nginx site, set it true. Without a
# proxy, leave it false.
KIP_TRUST_PROXY=true


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# The one directory that holds state: the database, its WAL/SHM siblings, the
# generated session secret, the live-process lock and the backups directory.
# Point it at the volume you actually back up.
#
#   systemd unit:  KIP_DATA_DIR=/var/lib/kampala-intel
#   container:     KIP_DATA_DIR=/data   (already forced by docker-compose.yml)
KIP_DATA_DIR=/var/lib/kampala-intel


# ---------------------------------------------------------------------------
# Sessions and sign-in
# ---------------------------------------------------------------------------
# The session signing secret. Left unset, the app generates one and persists it to
# `<KIP_DATA_DIR>/.session-secret`, which is fine for a single install on durable
# storage. Set it explicitly when more than one process shares the data directory,
# or when the data volume does not keep dotfiles, because in those cases a rebuild
# silently signs every operator out.
#
# Generate once, keep it in your secret manager:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# KIP_SESSION_SECRET=

# A working day. Lower it if the install is shared or the threat model is harsh.
KIP_SESSION_TTL_HOURS=12

# The floor for an operator password. The core layer refuses to go below what a
# hardening pass should ever want; raise it here if you like, never lower it.
KIP_MIN_PASSWORD_LENGTH=12


# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# The k-anonymity floor: any aggregate over fewer than this many distinct people
# is suppressed rather than published. Raising it protects more and reveals less.
# 5 matches the thresholds the README documents; a public test with small
# neighbourhoods is a reasonable place to raise it to 10.
KIP_K_THRESHOLD=5

# Salt rotation for the daily pseudonym. Daily is the point of the design; do not
# lengthen it without a reason, because a longer window is a longer linkable
# history for one person.
KIP_ROTATION_DAYS=1

# Raw query text is the only thing here that can name a person, so it is given the
# shortest life that still lets the aggregate trends work. The default is 30; a
# public test can afford to drop it to a week, because no route reads it anyway.
KIP_RAW_SEARCH_RETENTION_DAYS=7

# The pseudonymous aggregate outlives the raw text and is what the trend work
# uses. Must stay at or above the raw window; a higher raw value is clamped down.
KIP_EVENT_RETENTION_DAYS=90


# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Production logs are read on purpose or not at all. At `info` the structured
# output includes query timings and is noisy; `warn` keeps the lines worth waking
# up for. Set it back to `info` while debugging a deployment, then drop it again.
KIP_LOG_LEVEL=warn


# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# Reference geography and taxonomy: real-world data, imported on every start.
KIP_SEED_REFERENCE=true

# The demonstration organisation. It is invented content that arrives
# pending_review, and a public-facing install should not carry it. Off.
KIP_SEED_CATALOGUE_DEMO=false


# ---------------------------------------------------------------------------
# Administration
# ---------------------------------------------------------------------------
# Deliberately absent. These drive `npm run bootstrap`, `create-admin` and
# `set-password`, which are one-shot commands rather than the server, and an admin
# password sitting in a file the server loads on every start is a way to leak one.
# Pass them for the single command that needs them:
#
#   KIP_ADMIN_EMAIL=you@example.com KIP_ADMIN_PASSWORD='a-long-one' npm run create-admin
#
# There is no public sign-up and no mail transport, so every tester account is
# created this way, and a forgotten password is reset by the operator with
# `set-password` (or, in `production`, is not recoverable through the API at all).
